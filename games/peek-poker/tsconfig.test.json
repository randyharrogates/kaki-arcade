{
  "extends": "../../tsconfig.test.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "dist/.test.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "host/**/*.test.ts",
    "host/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.host.json"
    }
  ]
}
